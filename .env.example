# Copy this file to .env and fill in your keys. The local server auto-loads .env.
# On Vercel, set these in Project → Settings → Environment Variables instead.

# --- Database: Turso (libSQL) ---
# Create a free DB at https://turso.tech, then paste its URL + auth token here.
# Leave BOTH blank to use a local SQLite file (server/data/dump.db) for offline dev.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Auth ---
# REQUIRED in production. A strong random string; keep it stable so logins persist.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DUMP_JWT_SECRET=

# --- Groq API (server-side AI classification + screenshot OCR fallback) ---
GROQ_API_KEY=
# Optional model overrides (strong defaults shown)
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct

# --- OCR.space API key for reading links inside screenshots ---
# If empty, OCR falls back to the Groq vision model above.
OCR_API_KEY=

# --- Local server only ---
PORT=4000
